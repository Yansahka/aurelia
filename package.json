{
  "name": "aurelia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "dev:local": "node server/index.js",
    "dev:embedded": "node server/local.js",
    "db:setup-local": "node server/setup-postgres.js",
    "test:postgres": "node server/check-postgres.js",
    "test:catalogue:postgres": "node server/check-catalogue-postgres.js",
    "test:branding:postgres": "node server/check-branding-postgres.js",
    "test:variants:postgres": "node server/check-variants-postgres.js",
    "test:media:postgres": "node server/check-media-postgres.js",
    "test:journey:postgres": "node server/check-journey-postgres.js",
    "db:migrate": "node server/migrate.js",
    "build": "npm --prefix aurelia-front run build && npm --prefix aurelia-dashboard run build",
    "test": "node --test --test-concurrency=1 server/test/*.test.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14"
  }
}

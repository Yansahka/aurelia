PGHOST=localhost
PGPORT=5432
PGDATABASE=aurelia_db
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PORT=3000
NODE_ENV=development
# Origins des applications autorisées (sans slash final).
APP_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Pour un fournisseur PostgreSQL avec certificat CA spécifique : chemin PEM.
# PGSSLROOTCERT=C:/certs/provider-ca.pem
# PGSSLMODE=verify-full
# TRUST_PROXY=1 uniquement derrière votre reverse proxy de confiance.
# Images importées : dossier local du serveur (défaut : .local/uploads).
# MEDIA_DIRECTORY=C:/Aurelia/images

# E-mails de compte : mode local, aucun message envoyé sur Internet.
MAIL_MODE=file
# MAIL_DIRECTORY=C:/Aurelia/emails
APP_PUBLIC_URL=http://localhost:3000
# En production : MAIL_MODE=smtp, APP_PUBLIC_URL=https://votre-domaine
# MAIL_FROM=Aurelia <no-reply@votre-domaine>
# SMTP_HOST=smtp.votre-fournisseur
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=identifiant-smtp
# SMTP_PASSWORD=secret-a-renseigner-localement
